# ==========================================
# AVALIVE ECOSYSTEM V3 — ULTRA PREMIUM
# Environment Variables Template
# ==========================================

# Server & App Config
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (Postgres, RLS, Auth, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Gateway (Google AI Studio & Claude API)
GOOGLE_AI_STUDIO_API_KEY=your-gemini-api-key
CLAUDE_API_KEY=your-anthropic-api-key
DEFAULT_AI_MODEL=gemini-2.0-flash-exp

# Payment Gateway (SePay & International)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
SEPAY_ACCOUNT_NUMBER=88888888
SEPAY_BANK_CODE=MBBank

# TikTok Developers 2026 (Authorized Display API)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback
